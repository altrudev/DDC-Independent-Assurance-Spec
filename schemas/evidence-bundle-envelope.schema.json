{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddcal.ca/spec/schemas/evidence-bundle-envelope.schema.json",
  "title": "Evidence Bundle Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "case_revision",
    "cutoff_root",
    "evidence_root",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "ddcal.independent-assurance.evidence-bundle-envelope/0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "case_revision": {
      "type": "integer",
      "minimum": 0
    },
    "cutoff_root": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_root": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
